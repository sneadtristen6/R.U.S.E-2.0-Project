# --- the record's lines on the game's own error output: what tells the Launcher a match is on (rusemod.guard) ---
LINE = re.compile(r'gc: collectable <RUSEGUARD-MATCH ([^<>]*?) at (\d+) instance at')
STAMPS = []   # the game's clock times in the lines game_errors last read


class Drop(object):
    """The game's sys.stderr (TWrapperEugDebug): its write throws the text away."""

    def write(self, text):
        pass


def game_errors(run):
    """The RUSE Guard lines `run` puts on the program's own error output (the C runtime's stderr: where the game's
    Python writes its own lines when sys.stderr can't be written to), with the game's sys.stderr standing in as it is
    in the game. Returns (the lines, whether sys.stderr, gc's debug flags and gc's on/off were all put back)."""
    path = os.path.join(FOLDER, 'errors.txt')
    stand_in, flags, on = Drop(), gc.get_debug(), gc.isenabled()
    old, sys.stderr = sys.stderr, stand_in
    sys.__stderr__.flush()
    saved = os.dup(2)
    out = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
    try:
        os.dup2(out, 2)
        try:
            run()
        finally:
            sys.__stderr__.flush()
            os.dup2(saved, 2)
            back = (sys.stderr is stand_in, gc.get_debug() == flags, gc.isenabled() == on)
            sys.stderr = old
    finally:
        os.close(out)
        os.close(saved)
    text = open(path, 'rb').read()
    os.remove(path)
    found = LINE.findall(text)
    STAMPS[:] = [int(stamp) for _words, stamp in found]
    return [words for words, _stamp in found], back


LIVE_1_0, LIVE_0_1 = 'live multi 1 coop 0', 'live multi 0 coop 1'


@scenario('an honest copy in a multiplayer match: the record says the match is on, every 30 s, then that it ended')
def _(name):
    pc = PC('honest', HONEST)
    sim = Sim([pc])

    def play():
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=75.0)
        sim.close_worlds()
    lines, back = game_errors(play)
    # ten seconds in, then each third ten-second tick (40 s, 70 s), then the match's close
    expect(name, 'the lines', lines, [LIVE_1_0, LIVE_1_0, LIVE_1_0, 'end'])
    # each line carries the clock time of the moment it is said (the Launcher drops a late one)
    now = int(time.time())
    expect(name, 'every line carries the time now', [abs(s - now) <= 5 for s in STAMPS], [True] * 4)
    expect(name, 'sys.stderr, gc\'s debug flags and gc\'s on/off put back', back, (True, True, True))
    expect(name, 'stopped', pc.stopped, None)


@scenario('a co-op match: the record says so; a second match in the same session gets its own lines')
def _(name):
    pc = PC('honest', HONEST)
    sim = Sim([pc])

    def play():
        sim.match([(0, 'human'), (1, 'human'), (2, 'computer')], {'honest': 0}, seconds=15.0, multi=False,
                  coop=True)
        sim.close_worlds()
        sim.match([(0, 'human'), (1, 'computer')], {'honest': 0}, seconds=15.0)
        sim.close_worlds()
    lines, back = game_errors(play)
    expect(name, 'the lines', lines, [LIVE_0_1, 'end', LIVE_1_0, 'end'])
    expect(name, 'put back', back, (True, True, True))


@scenario('a skirmish against the computer, a replay, the game as bought: the record says nothing at all')
def _(name):
    honest, plain = PC('honest', HONEST), PC('plain', PLAIN)

    def play():
        sim = Sim([honest])
        sim.match([(0, 'human'), (1, 'computer')], {'honest': 0}, seconds=45.0, multi=False, coop=False)
        sim.close_worlds()
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=45.0, replay=True)
        sim.close_worlds()
        sim = Sim([plain])
        sim.match([(0, 'human'), (1, 'human')], {'plain': 0}, seconds=45.0)
        sim.close_worlds()
    lines, back = game_errors(play)
    expect(name, 'the lines', lines, [])
    expect(name, 'put back', back, (True, True, True))
    expect(name, 'stopped', (honest.stopped, plain.stopped), (None, None))


@scenario('a multiplayer match whose world never closes, then a skirmish, a replay, a second match: each match ends')
def _(name):
    # the world-close call (world.kill) is not known to run on every way out of a match (not known): the next match's
    # start, whatever kind it is, ends the one before, so the Launcher is told the match is over
    pc = PC('honest', HONEST)
    sim = Sim([pc])

    def play():
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=15.0)               # no close_worlds
        sim.match([(0, 'human'), (1, 'computer')], {'honest': 0}, seconds=45.0, multi=False, coop=False)
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=15.0)
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=45.0, replay=True)  # ends the one before
        sim.match([(0, 'human'), (1, 'computer')], {'honest': 0}, seconds=45.0, multi=False, coop=False)
    lines, back = game_errors(play)
    expect(name, 'the lines', lines, [LIVE_1_0, 'end', LIVE_1_0, 'end'])
    expect(name, 'put back', back, (True, True, True))
    # the skirmish and the replay after the matches say nothing at all, so no line is left that says "on"
    expect(name, 'the last line says the match is over', lines[-1], 'end')


@scenario('a match that turns out to be a replay after it started: its end is said and nothing more')
def _(name):
    pc = PC('honest', HONEST)
    sim = Sim([pc])

    def turns(sim):
        pc.world.replay = True

    def play():
        sim.match([(0, 'human'), (1, 'human')], {'honest': 0}, seconds=45.0, during={150: turns})
        sim.close_worlds()
    lines, back = game_errors(play)
    expect(name, 'the lines', lines, [LIVE_1_0, 'end'])
    expect(name, 'put back', back, (True, True, True))


@scenario('a cheat copy that leaves its match: the record\'s lines go on until the game stops it')
def _(name):
    cheat, other = PC('cheat', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([cheat, other])

    def play():
        sim.match([(0, 'human'), (1, 'human')], {'cheat': 0, 'plain': 1}, seconds=15.0)
    lines, back = game_errors(play)
    expect(name, 'the lines before the end screen stopped it', lines, [LIVE_1_0])
    expect(name, 'the cheat copy was stopped on its end screen', (cheat.stopped or '')[:28],
           'RuntimeError: RUSEGUARD-LOCK')


# --- game objects that fail on every use: what may never let an error out, even in a cheat copy ---
class Boom(Exception):
    pass


class Bomb(object):
    def __getattr__(self, name):
        raise Boom('the game object failed on .%s' % name)

    def __call__(self, *args):
        raise Boom('the game object failed when called')

    def __iter__(self):
        raise Boom('the game object failed when listed')


@scenario('an order arriving with game objects that fail on every use: the lock lets no error out')
def _(name):
    p1, p2 = PC('one', CHEAT_A), PC('two', CHEAT_A2)
    sim = Sim([p1, p2])
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'two': 1})
    p1.enter()
    helpers = sys.modules['base.actions.helpers']
    expect(name, 'the lock\'s handler is in place', helpers.Recv_AnnuleProduction.__name__, 'Recv_AnnuleProduction')
    real = p1.world.camps[1]
    try:
        # a failing number, with a real side: our part fails quietly, the game's own part still runs
        class BadNumber(object):
            def __cmp__(self, other):
                raise Boom('the number failed to compare')
        try:
            helpers.Recv_AnnuleProduction(real, BadNumber(), HEADQUARTER)
        except TypeError:
            pass  # from the stand-in game's own lookup, not from the lock
        # a side whose number can't be read, with one of RUSE Guard's numbers: our part quiet, the game's own
        # handler gets the order as it came
        class NoNumber(Camp):
            teamnum = property(lambda self: Bomb()())
        try:
            odd = NoNumber.__new__(NoNumber)
            odd.factories = real.factories
            helpers.Recv_AnnuleProduction(odd, 0x40000000 | 7, HEADQUARTER)
        except Boom, e:
            FAILS.append('%s: the lock let an error out: %s' % (name, e))
    except Boom, e:
        FAILS.append('%s: the lock let an error out: %s' % (name, e))


# --- the close at the end-of-match screen (the owner, 2026-11-24: "change it to only go to our server"; his 22 A and
# 35 A, 2026-11-25): only the end screen of the very match the copy left, a multiplayer one, closes the game ---
def leave_before_end(pc):
    def go(sim):
        pc.stopped = 'quit to the menu before the end screen'
    return go


def back_in_menus(pc):
    pc.stopped = None   # the game still runs: the player is back in the menus


@scenario('left a match and quit to the menu before its end screen, then a skirmish against the computer: no close')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    orders = sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, during={END_TICK: leave_before_end(p1)})
    expect(name, 'the first match was left', len(sent(orders, 'one', 'Surrender')), 1)
    expect(name, 'no close without the end screen', quits(p1), [])
    back_in_menus(p1)
    sim.pcs = [p1]
    orders = sim.match([(0, 'human'), (1, 'computer')], {'one': 0}, multi=False, coop=False)
    expect(name, 'orders in the skirmish', orders, [])
    expect(name, 'the skirmish end screen', (quits(p1), p1.stopped, p1.end_screens), ([], None, 1))


@scenario('a co-op match left (its end screen is the solo kind), then a skirmish against the computer: no close')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    orders = sim.match([(0, 'human'), (1, 'human'), (2, 'computer')], {'one': 0, 'plain': 1}, multi=False, coop=True)
    expect(name, 'the co-op match was given up', len(sent(orders, 'one', 'Surrender')), 1)
    expect(name, 'the co-op end screen (co-op only gives up)', (quits(p1), p1.stopped), ([], None))
    sim.pcs = [p1]
    sim.match([(0, 'human'), (1, 'computer')], {'one': 0}, multi=False, coop=False)
    expect(name, 'the skirmish end screen', (quits(p1), p1.stopped), ([], None))


@scenario('a ranked match left (its end screen has its own show), then a skirmish: no close, only given up')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    orders = sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, ranked=True)
    expect(name, 'the ranked match was given up', len(sent(orders, 'one', 'Surrender')), 1)
    expect(name, 'the ranked end screen (ranked only gives up)', (quits(p1), p1.stopped), ([], None))
    sim.pcs = [p1]
    sim.match([(0, 'human'), (1, 'computer')], {'one': 0}, multi=False, coop=False)
    expect(name, 'the skirmish end screen', (quits(p1), p1.stopped), ([], None))


@scenario('another match\'s end screen with no match start between (a replay\'s, say): no close')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, during={END_TICK: leave_before_end(p1)})
    back_in_menus(p1)
    other = World(sim, p1, [(0, 'human'), (1, 'computer')], 0)

    def show():
        sys.modules['headup.end_game_screens'].EndGameScreenMultiBattle(other).show()
    p1.call(show)
    expect(name, 'closes, stopped', (quits(p1), p1.stopped), ([], None))


@scenario('the game refuses its quit: the copy says so once, on its own end screen, with no error and no second try')
def _(name):
    cheat, other = PC('cheat', CHEAT_A), PC('plain', PLAIN)
    cheat.quit_mode = 'refuses'
    sim = Sim([cheat, other])
    sim.match([(0, 'human'), (1, 'human')], {'cheat': 0, 'plain': 1})
    left = cheat.world

    def again():
        sys.modules['headup.end_game_screens'].EndGameScreenMultiNotChampionship(left).show()
    cheat.call(again)
    expect(name, 'an error left', cheat.stopped, None)
    expect(name, 'said it could not close (once, at the end screen)', says(cheat, "couldn't close the game"),
           [END_TICK])
    expect(name, 'closes', quits(cheat), [])


@scenario('the game has no _sysutils, or no TerminateSelf: no error, the line once, the surrender as before')
def _(name):
    for mode in ('no module', 'no function'):
        cheat, other = PC('cheat', CHEAT_A), PC('plain', PLAIN)
        cheat.quit_mode = mode
        sim = Sim([cheat, other])
        orders = sim.match([(0, 'human'), (1, 'human')], {'cheat': 0, 'plain': 1})
        expect(name, '%s: surrendered' % mode, len(sent(orders, 'cheat', 'Surrender')), 1)
        expect(name, '%s: an error left' % mode, cheat.stopped, None)
        expect(name, '%s: said it could not close' % mode, len(says(cheat, "couldn't close the game")), 1)


@scenario('the game refuses the surrender: no error leaves; the copy closes the game at once with the number')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])

    def broken(team):
        raise RuntimeError('the game refused the surrender')
    p1.modules['base.actions.helpers'].Send_Surrender = broken
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1})
    expect(name, 'how it ended', (p1.stopped, quits(p1)), (CLOSED, [(LEAVE_TICK, (LOCK_EXIT, False))]))
    expect(name, 'the plain game', (p3.stopped, quits(p3)), (None, []))


@scenario('the game refuses the surrender AND its quit: no error, the line, the copy stays')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    p1.quit_mode = 'refuses'
    sim = Sim([p1, p3])

    def broken(team):
        raise RuntimeError('the game refused the surrender')
    p1.modules['base.actions.helpers'].Send_Surrender = broken
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1})
    expect(name, 'an error left', p1.stopped, None)
    expect(name, 'said it could not close', says(p1, "couldn't close the game"), [LEAVE_TICK])


@scenario('matches that never close: the same build, one human with computers, co-op with the same build, honest')
def _(name):
    p1, p2 = PC('first', CHEAT_A), PC('friend', CHEAT_A2)
    Sim([p1, p2]).match([(0, 'human'), (1, 'human'), (2, 'computer')], {'first': 0, 'friend': 1})
    alone = PC('alone', CHEAT_A)
    Sim([alone]).match([(0, 'human'), (1, 'computer')], {'alone': 0})
    pcs = [PC('p%d' % k, (CHEAT_A, CHEAT_A2)[k % 2]) for k in range(4)]
    Sim(pcs).match([(k, 'human') for k in range(4)] + [(4, 'computer')], dict([('p%d' % k, k) for k in range(4)]),
                   multi=False, coop=True)
    honest, cheat = PC('honest', HONEST), PC('cheat', CHEAT_A)
    Sim([honest, cheat]).match([(0, 'human'), (1, 'human')], {'honest': 0, 'cheat': 1})
    for pc in [p1, p2, alone, honest] + pcs:
        expect(name, '%s: closes, stopped' % pc.name, (quits(pc), pc.stopped), ([], None))


@scenario('an end screen whose world fails on every use: the lock lets no error out')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, during={END_TICK: leave_before_end(p1)})
    back_in_menus(p1)

    def show():
        screens = sys.modules['headup.end_game_screens']

        class Odd(screens.EndGameScreenMulti):
            _world = property(lambda self: Bomb()())
        Odd.__new__(Odd)._show_end_game_screen(None)
    p1.call(show)
    expect(name, 'an error left', p1.stopped, None)


@scenario('the next match is handed the SAME world: the match start alone clears the leave, so no close')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, during={END_TICK: leave_before_end(p1)})
    back_in_menus(p1)
    sim.pcs = [p1]
    sim.match([(0, 'human'), (1, 'computer')], {'one': 0}, multi=False, coop=False, same_world=True)
    expect(name, 'the skirmish end screen', (quits(p1), p1.stopped), ([], None))


@scenario('a co-op match left whose end screen IS the multiplayer kind (if the game showed one): no close')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    sim = Sim([p1, p3])
    orders = sim.match([(0, 'human'), (1, 'human'), (2, 'computer')], {'one': 0, 'plain': 1}, multi=False, coop=True,
                       end_kind='EndGameScreenMultiBattle')
    expect(name, 'the co-op match was given up', len(sent(orders, 'one', 'Surrender')), 1)
    expect(name, 'that end screen', (quits(p1), p1.stopped, p1.end_screens), ([], None, 1))
    orders = sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1}, multi=True, coop=True,
                       end_kind='EndGameScreenMultiNotChampionship')
    expect(name, 'a match that says both multiplayer and co-op: given up', len(sent(orders, 'one', 'Surrender')), 1)
    expect(name, 'a match that says both: closes', quits(p1), [])


@scenario('the first close refused, the copy stays on; a later match of the session left again closes, once')
def _(name):
    p1, p3 = PC('one', CHEAT_A), PC('plain', PLAIN)
    p1.quit_mode = 'refuses'
    sim = Sim([p1, p3])
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1})
    p1.quit_mode = 'works'
    sim.match([(0, 'human'), (1, 'human')], {'one': 0, 'plain': 1})
    expect(name, 'closes', quits(p1), CLOSE)


# --- the lock's lines in the player's language (the owner's 23, 2026-11-25: "Yes, I agree with 23 in every
# language"): a copy built in French or Persian says the very lines the app gave the build ---
WORDS = []
if have('lock_fr') and have('lock_fa') and os.path.isfile(os.path.join(FOLDER, 'words.txt')):
    WORDS = open(os.path.join(FOLDER, 'words.txt'), 'rb').read().decode('utf-8').split('\n')
    LOCK_FR, LOCK_FA = (blob('lock_fr'), WATCH, RECORD), (blob('lock_fa'), WATCH, RECORD)
    FRENCH, PERSIAN = WORDS[0:4], WORDS[4:8]
    ENGLISH_CHECK = 'Checking that every player in this match has the same build'

    @scenario('a cheat copy built in French says every line in French, the very text the app gave, no English')
    def _(name):
        cheat, other = PC('cheat', LOCK_FR), PC('plain', PLAIN)
        sim = Sim([cheat, other])
        sim.match([(0, 'human'), (1, 'human')], {'cheat': 0, 'plain': 1})
        expect(name, 'what it said', [text for t, text in cheat.said], [FRENCH[0], FRENCH[2]])
        expect(name, 'how it ended', (cheat.stopped, quits(cheat)), (CLOSED, CLOSE))
        p1, p2 = PC('one', LOCK_FR), PC('two', CHEAT_A2)   # the same build, one copy built in French
        Sim([p1, p2]).match([(0, 'human'), (1, 'human')], {'one': 0, 'two': 1})
        expect(name, 'the same build, in French', [text for t, text in p1.said], [FRENCH[0], FRENCH[1]])
        expect(name, 'the other, in English', len(says(p2, 'The match goes on')), 1)
        refused = PC('refused', LOCK_FR)
        refused.quit_mode = 'refuses'
        Sim([refused, PC('plain', PLAIN)]).match([(0, 'human'), (1, 'human')], {'refused': 0, 'plain': 1})
        expect(name, 'the close refused, in French', [text for t, text in refused.said][-1:], [FRENCH[3]])

    @scenario('built in Persian: the Persian lines; a game that refuses those letters says the English, no error')
    def _(name):
        cheat, other = PC('cheat', LOCK_FA), PC('plain', PLAIN)
        Sim([cheat, other]).match([(0, 'human'), (1, 'human')], {'cheat': 0, 'plain': 1})
        expect(name, 'what it said', [text for t, text in cheat.said], [PERSIAN[0], PERSIAN[2]])
        no_letters = PC('ascii', LOCK_FA)
        no_letters.letters = 'ascii'
        no_letters.quit_mode = 'refuses'
        Sim([no_letters, PC('plain', PLAIN)]).match([(0, 'human'), (1, 'human')], {'ascii': 0, 'plain': 1})
        said = [text for t, text in no_letters.said]
        expect(name, 'the English instead, every line', (len(said), ENGLISH_CHECK in said[0],
                                                          'leaves the match' in said[1],
                                                          "couldn't close the game" in said[2]), (3, True, True, True))
        expect(name, 'an error left', no_letters.stopped, None)


for name, ok in RESULTS:
    print '%-6s %s' % (('FAILED', 'ok')[ok], name)
print
for line in FAILS:
    print 'FAILED:', line
print '%d of %d matches as expected' % (len([1 for n, ok in RESULTS if ok]), len(RESULTS))
sys.exit((0, 1)[bool(FAILS)])

// C5, C6 and C6b: a Lee copy never shows in the menu, at any slot (the real Lee showed at 306). Suspects:
// - ClassNameForDebug: the game's Python unit list (parametres/classes.xyz) has one class per unit with exactly
//   these names (class Unit_M3_Lee); a copy renamed to Unit_R2_... has none.
// - DescriptorId: copies get the highest id + 1 (4059), past every id the game shipped with (1..4058).
// Each probe keeps a different one, at its own price, so one look at the US armour menu tells which matters.

// Probe A ($1): keeps the Lee's class name, new id 4059.
export Descriptor_Unit_R2_Probe_A is clone $/GFX/Everything/Descriptor_Unit_M3_Lee
(
    ProductionPrice = [1, 1, 1, 1, 1]
    NameInMenuToken = loc('probe.a')
    ClassNameForDebug = 'Unit_M3_Lee'
    PositionInMenu = 307
)

// Probe B ($2): new class name, an id inside the shipped range.
export Descriptor_Unit_R2_Probe_B is clone $/GFX/Everything/Descriptor_Unit_M3_Lee
(
    ProductionPrice = [2, 2, 2, 2, 2]
    NameInMenuToken = loc('probe.b')
    DescriptorId = 2000
    PositionInMenu = 308
)

// Probe C ($3): both.
export Descriptor_Unit_R2_Probe_C is clone $/GFX/Everything/Descriptor_Unit_M3_Lee
(
    ProductionPrice = [3, 3, 3, 3, 3]
    NameInMenuToken = loc('probe.c')
    ClassNameForDebug = 'Unit_M3_Lee'
    DescriptorId = 2001
    PositionInMenu = 309
)
